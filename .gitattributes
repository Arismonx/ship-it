# Normalise line endings; Go and shell files always LF
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.ico binary

# testscript archives must keep exact bytes
*.txtar text eol=lf -diff

# Generated files: collapsed in GitHub diffs, excluded from the PR size guard
schemas/** linguist-generated=true
extensions/vscode/src/generated/** linguist-generated=true
testdata/golden/** linguist-generated=true
